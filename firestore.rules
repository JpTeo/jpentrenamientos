rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCoach() {
      return isSignedIn() && myRole() == 'coach';
    }

    // For students: the uid of the coach who created their account.
    function myCoachId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('createdBy', null);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCoach());
      allow create: if isCoach()
        && request.resource.data.role == 'student'
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isCoach() && resource.data.createdBy == request.auth.uid;
      // A student can only fill in their own first-login questionnaire.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['birthDate', 'heightCm', 'weightKg', 'onboardingDone', 'onboardingAt']);
    }

    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isCoach() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isCoach() && resource.data.createdBy == request.auth.uid;
    }

    match /plans/{planId} {
      allow read: if isSignedIn()
        && (resource.data.coachId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update: if (isCoach() && resource.data.coachId == request.auth.uid)
        || (isSignedIn() && resource.data.studentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['items', 'updatedAt', 'completionCount', 'lastCompletedAt']));
      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    match /planTemplates/{templateId} {
      allow read: if isCoach() && resource.data.coachId == request.auth.uid;
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    match /exerciseComments/{commentId} {
      allow read: if isCoach() && resource.data.coachId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    match /personalRecords/{recordId} {
      allow read: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow update: if false;
    }

    match /planCompletions/{completionId} {
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isCoach() && resource.data.coachId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Challenges the coach creates; students see their own coach's.
    match /challenges/{challengeId} {
      allow read: if isSignedIn()
        && (resource.data.coachId == request.auth.uid || resource.data.coachId == myCoachId());
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    // One doc per (challenge, student) — the id enforces "once per student".
    // The points must match the challenge's current points and it must be
    // active, so a student can't award themselves arbitrary points.
    match /challengeCompletions/{completionId} {
      // Classmates (same coach) can read them: Comunidad JP adds them up.
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.coachId == request.auth.uid
          || resource.data.coachId == myCoachId());
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && completionId == request.resource.data.challengeId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.active == true
        && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.points == request.resource.data.points
        && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.coachId == request.resource.data.coachId;
      allow update: if false;
      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    // "Hoy entrené": one check-in per student per day (the id is
    // <uid>_<YYYY-MM-DD>), worth a fixed 30 points. Keep 30 in sync with
    // CHECKIN_POINTS in src/lib/checkins.js.
    match /trainingCheckins/{checkinId} {
      // Classmates (same coach) can read them: Comunidad JP adds them up.
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.coachId == request.auth.uid
          || resource.data.coachId == myCoachId());
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.coachId == myCoachId()
        && request.resource.data.points == 30
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && checkinId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 100;
      allow update: if isCoach() && resource.data.coachId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    // Comunidad JP directory: just a name and the coach, safe to show to
    // classmates (the real `users` docs hold email/password and stay private).
    // A student writes their own entry; the coach can write/backfill any of
    // theirs.
    match /communityProfiles/{profileId} {
      allow read: if isSignedIn()
        && (resource.data.coachId == request.auth.uid || resource.data.coachId == myCoachId());
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'coachId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && ((request.auth.uid == profileId && request.resource.data.coachId == myCoachId())
          || (isCoach() && request.resource.data.coachId == request.auth.uid));
      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow read: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activity', 'durationMinutes', 'intensity']);
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }
  }
}
